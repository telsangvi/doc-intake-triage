# Copy to .env and fill in only if you want to use a real model.
# The project runs with provider=mock and NO keys set.

# mock | openai | anthropic
DOC_TRIAGE_PROVIDER=mock
DOC_TRIAGE_MODEL=gpt-4o-mini

# Only needed for the matching provider above. NEVER commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Routing thresholds (tune these during your "eval" phase)
LOW_CONF_THRESHOLD=0.60
HIGH_CONF_THRESHOLD=0.85
