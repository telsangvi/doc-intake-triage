# Copy to .env and fill in only if you want to use a real model or a real
# vector store. The project runs with provider=mock and no keys set.

# mock | openai | anthropic
DOC_TRIAGE_PROVIDER=mock
DOC_TRIAGE_MODEL=gpt-4o-mini

# Only needed for the matching provider above. NEVER commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Routing thresholds (tune these during your "eval" phase)
LOW_CONF_THRESHOLD=0.60
HIGH_CONF_THRESHOLD=0.85

# --- Vector store -----------------------------------------------------------
# memory (offline, default) | supabase
RETRIEVER_BACKEND=memory

# Embedding dimension. 1536 matches OpenAI text-embedding-3-small.
EMBEDDING_DIM=1536

# Postgres connection string for the supabase backend. Comes from the
# environment ONLY — never commit this, never paste it into a chat.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
